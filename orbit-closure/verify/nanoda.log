def PEqualNP.Gct.linSubst :
  forall {ι R : Type 0} [inst._@.OrbitStatement.3913716447._hygCtx._hyg.4 : Fintype ι]
    [inst._@.OrbitStatement.3913716447._hygCtx._hyg.7 : CommRing R],
  Matrix ι ι R → MvPolynomial ι R → MvPolynomial ι R :=
  fun {ι R : Type 0} [inst._@.OrbitStatement.3913716447._hygCtx._hyg.4 : Fintype ι]
    [inst._@.OrbitStatement.3913716447._hygCtx._hyg.7 : CommRing R] (g : Matrix ι ι R) (f : MvPolynomial ι R) =>
  DFunLike.coe
    (MvPolynomial.bind₁
      (fun (i : ι) =>
      Finset.sum Finset.univ (fun (j : ι) => HMul.hMul (DFunLike.coe MvPolynomial.C (g i j)) (MvPolynomial.X j)))) f

def PEqualNP.Gct.orbitClosure :
  forall {ι : Type 0} [inst._@.OrbitStatement.1597486160._hygCtx._hyg.3 : Fintype ι]
    [inst._@.OrbitStatement.1597486160._hygCtx._hyg.6 : DecidableEq ι],
  MvPolynomial ι Complex → Set (MvPolynomial ι Complex) :=
  fun {ι : Type 0} [inst._@.OrbitStatement.1597486160._hygCtx._hyg.3 : Fintype ι]
    [inst._@.OrbitStatement.1597486160._hygCtx._hyg.6 : DecidableEq ι] (f : MvPolynomial ι Complex) =>
  Set.ofPred
    (fun (h : MvPolynomial ι Complex) =>
    Exists
      (fun (g : Nat → Matrix.GeneralLinearGroup ι Complex) =>
      forall (s : Finsupp ι Nat),
      Filter.Tendsto (fun (k : Nat) => MvPolynomial.coeff s (PEqualNP.Gct.linSubst (Units.val (g k)) f)) Filter.atTop
        (nhds (MvPolynomial.coeff s h))))

def PEqualNP.Gct.padIndex (m n : Nat) (p : Prod (Fin m) (Fin m)) :
  Prod (Fin (HAdd.hAdd n (OfNat.ofNat 1))) (Fin (HAdd.hAdd n (OfNat.ofNat 1))) :=
  Prod.mk (Fin.ofNat (HAdd.hAdd n (OfNat.ofNat 1)) (HAdd.hAdd (Fin.val (Prod.fst p)) (OfNat.ofNat 1)))
    (Fin.ofNat (HAdd.hAdd n (OfNat.ofNat 1)) (HAdd.hAdd (Fin.val (Prod.snd p)) (OfNat.ofNat 1)))

def PEqualNP.Gct.paddedPerm (R : Type 0) :
  forall [inst._@.OrbitStatement.1669686271._hygCtx._hyg.3 : CommRing R],
  Nat → (forall (n : Nat),
  MvPolynomial (Prod (Fin (HAdd.hAdd n (OfNat.ofNat 1))) (Fin (HAdd.hAdd n (OfNat.ofNat 1)))) R) :=
  fun [inst._@.OrbitStatement.1669686271._hygCtx._hyg.3 : CommRing R] (m n : Nat) =>
  HMul.hMul
    (HPow.hPow (MvPolynomial.X (Prod.mk (OfNat.ofNat 0) (OfNat.ofNat 0))) (HSub.hSub (HAdd.hAdd n (OfNat.ofNat 1)) m))
    (DFunLike.coe (MvPolynomial.rename (PEqualNP.Gct.padIndex m n)) (PEqualNP.Gct.permPoly R m))

def PEqualNP.Gct.zariskiOrbitClosure :
  forall {ι : Type 0} [inst._@.OrbitStatement.1597486160._hygCtx._hyg.3 : Fintype ι]
    [inst._@.OrbitStatement.1597486160._hygCtx._hyg.6 : DecidableEq ι],
  MvPolynomial ι Complex → Set (MvPolynomial ι Complex) :=
  fun {ι : Type 0} [inst._@.OrbitStatement.4076191376._hygCtx._hyg.3 : Fintype ι]
    [inst._@.OrbitStatement.4076191376._hygCtx._hyg.6 : DecidableEq ι] (f : MvPolynomial ι Complex) =>
  Set.ofPred
    (fun (h : MvPolynomial ι Complex) =>
    forall (Q : MvPolynomial (Finsupp ι Nat) Complex),
    (forall (g : Matrix.GeneralLinearGroup ι Complex),
      Eq
        (DFunLike.coe
          (MvPolynomial.eval (fun (s : Finsupp ι Nat) => MvPolynomial.coeff s (PEqualNP.Gct.linSubst (Units.val g) f)))
          Q) (OfNat.ofNat 0)) →
    Eq (DFunLike.coe (MvPolynomial.eval (fun (s : Finsupp ι Nat) => MvPolynomial.coeff s h)) Q) (OfNat.ofNat 0))

def PEqualNP.Gct.projectiveSLClosure :
  forall {ι : Type 0} [inst._@.OrbitStatement.1597486160._hygCtx._hyg.3 : Fintype ι]
    [inst._@.OrbitStatement.1597486160._hygCtx._hyg.6 : DecidableEq ι],
