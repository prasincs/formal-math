    [inst._@.OrbitStatement.3394481161._hygCtx._hyg.6 : DecidableEq ι] (f : MvPolynomial ι Complex) =>
  Set.ofPred
    (fun (h : MvPolynomial ι Complex) =>
    Exists
      (fun (g : Nat → Matrix.SpecialLinearGroup ι Complex) =>
      Exists
        (fun (a : Nat → Complex) =>
        forall (s : Finsupp ι Nat),
        Filter.Tendsto
          (fun (k : Nat) => HMul.hMul (a k) (MvPolynomial.coeff s (PEqualNP.Gct.linSubst (Subtype.val (g k)) f)))
          Filter.atTop (nhds (MvPolynomial.coeff s h)))))

def PEqualNP.Gct.HasDetExpression :
  forall {σ R : Type 0} [inst._@.OrbitStatement.3776430850._hygCtx._hyg.4 : CommRing R],
  MvPolynomial σ R → Nat → Sort 0 :=
  fun {σ R : Type 0} [inst._@.OrbitStatement.3776430850._hygCtx._hyg.4 : CommRing R] (p : MvPolynomial σ R)
    (n : Nat) =>
  Exists
    (fun (A : Matrix (Fin n) (Fin n) (MvPolynomial σ R)) =>
    And (forall (i j : Fin n), LE.le (MvPolynomial.totalDegree (A i j)) (OfNat.ofNat 1)) (Eq (Matrix.det A) p))

def PEqualNP.Gct.HasBorderDetExpression :
  forall {σ : Type 0}, MvPolynomial σ Complex → Nat → Sort 0 :=
  fun {σ : Type 0} (p : MvPolynomial σ Complex) (n : Nat) =>
  Exists
    (fun (q : Nat → MvPolynomial σ Complex) =>
    And (forall (k : Nat), PEqualNP.Gct.HasDetExpression (q k) n)
      (forall (s : Finsupp σ Nat),
      Filter.Tendsto (fun (k : Nat) => MvPolynomial.coeff s (q k)) Filter.atTop (nhds (MvPolynomial.coeff s p))))

