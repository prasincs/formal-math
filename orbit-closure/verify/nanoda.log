def PaddedPermanentNotMem :
  Sort 0 :=
  forall (c : Nat),
  LE.le (OfNat.ofNat 1) c → Exists
    (fun (m₀ : Nat) =>
    forall (m : Nat),
    GE.ge m m₀ → Not
      (Membership.mem
        (PEqualNP.Gct.orbitClosure (PEqualNP.Gct.detPoly Complex (HAdd.hAdd (HPow.hPow m c) (OfNat.ofNat 1))))
        (PEqualNP.Gct.paddedPerm Complex m (HPow.hPow m c))))

