def BorderDetSuperpolynomial :
  Sort 0 :=
  forall (d : Nat),
  Exists
    (fun (m₀ : Nat) =>
    forall (m : Nat),
    GE.ge m m₀ → (forall (n : Nat),
    PEqualNP.Gct.HasBorderDetExpression (PEqualNP.Gct.permPoly Complex m) n → LT.lt (HPow.hPow m d) n))

